+                                        $ map
+                                            (\ (ConDecl name _ _ _ _) -> name)
+                                            constrs)]
+                                   ++ (map
+                                         (\ (value1, value2) ->
+                                           case
+                                             applys
+                                               (unwrap
+                                                  "tycldecl TyData lookup compare"
+                                                $ lookup
+                                                    (mk_var "compare")
+                                                    methods)
+                                               [value1, value2]
+                                           of
+                                             Data constr _
+                                               | constr == mk_constr "LT" -> LT
+                                               | constr == mk_constr "EQ" -> EQ
+                                               | constr == mk_constr "GT" ->
+                                                 GT)
+                                       $ zip values1 values2)
+                                   <= [EQ] ++ map (\ _ -> EQ) values1))),
+                (">=",
+                 Function
+                   (\ x1 ->
+                     Function
+                       (\ x2 ->
+                         bool_to_value
+                         $ case x1 of
+                             Data constr1 values1 ->
+                               case x2 of
+                                 Data constr2 values2 ->
+                                   [(unwrap "deriving >= elemIndex constr1"
+                                     $ elemIndex constr1
+                                     $ map rdrNameOcc
+                                     $ map
+                                         (\ (ConDecl name _ _ _ _) -> name)
+                                         constrs)
+                                     `compare`
+                                       (unwrap "deriving >= elemIndex constr2"
+                                        $ elemIndex constr1
+                                        $ map rdrNameOcc
+                                        $ map
+                                            (\ (ConDecl name _ _ _ _) -> name)
+                                            constrs)]
+                                   ++ (map
+                                         (\ (value1, value2) ->
+                                           case
+                                             applys
+                                               (unwrap
+                                                  "tycldecl TyData lookup compare"
+                                                $ lookup
+                                                    (mk_var "compare")
+                                                    methods)
+                                               [value1, value2]
+                                           of
+                                             Data constr _
+                                               | constr == mk_constr "LT" -> LT
+                                               | constr == mk_constr "EQ" -> EQ
+                                               | constr == mk_constr "GT" ->
+                                                 GT)
+                                       $ zip values1 values2)
+                                   >= [EQ] ++ map (\ _ -> EQ) values1))),
+                (">", error "TODO >"),
+                ("max", error "TODO max"),
+                ("min", error "TODO min")]
+             else if deriving_ == mk_class "Read" then
+               map
+                 (\ name -> (name, error ("TODO " ++ name)))
+                 ["readsPrec", "readList"]
+             else if deriving_ == mk_class "Show" then
+               map
+                 (\ name -> (name, error ("TODO " ++ name)))
+                 ["showsPrec", "show", "showList"]
+             else
+               error ("TODO tycldecl TyData " ++ occNameUserString deriving_))
+       $ case derivings of
+           Nothing -> []
+           Just [] -> []
+           Just derivings -> map rdrNameOcc derivings,
+       [])
+      where
+        fieldss =
+          map
+            (\ (ConDecl name _ _ details _) ->
+              (rdrNameOcc name,
+               map rdrNameOcc
+               $ case details of
+                   VanillaCon _ -> []
+                   InfixCon _ _ -> []
+                   RecCon fieldss -> concat $ map fst fieldss
+                   NewCon _ Nothing -> []
+                   NewCon _ (Just field) -> [field]))
+            constrs
+        var_name = rdrNameOcc name
+    tycldecl (TySynonym _ _ _ _) _ =
+      trace "tycldecl TySynonym" $
+      ([], [], [], [], [])
+    tycldecl (ClassDecl _ _ [UserTyVar var] sigs monobinds_ _ _ _ _) env =
+      trace "tycldecl ClassDecl [UserTyVar]" $
+      ([],
+       [],
+       map (\ (name, (i, k)) -> (rdrNameOcc name, (i, k)))
+       $ map
+           (\ sig ->
+             case sig of
+               Sig _ _ _ -> error "Sig"
+               ClassOpSig name Nothing (HsForAllTy _ _ (MonoFunTy (MonoTyVar var0) _)) _
+                 | var == var0 -> (name, (0, (\ value -> value)))
+               ClassOpSig name Nothing (HsForAllTy _ _ (MonoFunTy (MonoTyApp (MonoTyVar var0) _) _)) _
+                 | var == var0 -> (name, (0, (\ value -> value)))
+               ClassOpSig name Nothing (HsForAllTy _ _ (MonoFunTy (MonoTupleTy [MonoTyVar var0, _] _) _)) _
+                 | var == var0 -> (name, (0, (\ (Data _ [value, _]) -> value)))
+               ClassOpSig name Nothing (HsForAllTy _ _ (MonoFunTy _ (MonoFunTy (MonoTyVar var1) _))) _
+                 | var == var1 -> (name, (1, (\ value -> value)))
+               ClassOpSig name Nothing (HsForAllTy _ _ (MonoFunTy _ (MonoFunTy (MonoTyApp (MonoTyVar var1) _) _))) _
+                 | var == var1 -> (name, (1, (\ value -> value)))
+               ClassOpSig _ Nothing (HsForAllTy _ _ (MonoFunTy _ (MonoFunTy _ (MonoFunTy _ _)))) _ ->
+                 error "fun x3"
+               ClassOpSig name Nothing (HsForAllTy _ _ _) _ ->
+                 (name,
+                  (error
+                     ("can't guess the instance "
+                      ++ (occNameUserString $ rdrNameOcc name)),
+                   error
+                     ("can't guess the instance "
+                      ++ (occNameUserString $ rdrNameOcc name))))
+               ClassOpSig _ Nothing (MonoTyVar _) _ ->
+                 error "ClassOpSig MonoTyVar"
+               ClassOpSig _ Nothing (MonoTyApp _ _) _ ->
+                 error "ClassOpSig MonoTyApp"
+               ClassOpSig _ Nothing (MonoFunTy _ _) _ ->
+                 error "ClassOpSig MonoFunTy"
+               ClassOpSig _ Nothing (MonoListTy _) _ ->
+                 error "ClassOpSig MonoListTy"
+               ClassOpSig _ Nothing (MonoTupleTy _ _) _ ->
+                 error "ClassOpSig MonoTupleTy"
+               ClassOpSig _ Nothing (MonoDictTy _ _) _ ->
+                 error "ClassOpSig MonoDictTy"
+               ClassOpSig _ (Just _) _ _ -> error "ClassOpSig Just"
+               SpecSig _ _ _ _ -> error "SpecSig"
+               InlineSig _ _ -> error "InlineSig"
+               NoInlineSig _ _ -> error "NoInlineSig"
+               SpecInstSig _ _ -> error "SpecInstSig"
+               FixSig _ -> error "FixSig")
+           sigs,
+       [],
+       monobinds monobinds_ env)
+    tycldecl (ClassDecl _ _ _ _ _ _ _ _ _) _ = error "TODO tycldecl ClassDecl"
+
+    typeof (Data constr _) =
+      unwrap "typeof Data lookup constr" $ lookup constr constructors
+    typeof (Function _) = error "TODO typeof Function"
+    typeof (Addr _) = mk_type "Addr#"
+    typeof (Array_ _) = error "TODO typeof Array"
+    typeof (ByteArray_ _) = error "TODO typeof ByteArray"
+    typeof (Char _) = mk_type "Char#"
+    typeof (ForeignObj_ _) = error "TODO typeof ForeignObj"
+    typeof (Int _) = error "TODO typeof Int"
+    typeof (MutableArray_ _) = error "TODO typeof MutableArray"
+    typeof (MutableByteArray_ _) = error "TODO typeof MutableByteArray"
+    typeof (MutVar _) = error "TODO typeof MutVar"
+    typeof (State _) = error "TODO typeof State"
+    typeof (Weak_ _) = error "TODO typeof Weak"
+    typeof (Word _) = error "TODO typeof Word"
+
+    unwrap error_msg (Just x) = x
+    unwrap error_msg Nothing = error error_msg
+
+    value_to_addr value =
+      A# (value_to_addr# (case value of Data _ [value] -> value))
+
+    value_to_addr# (Addr addr#) = addr#
+
+    value_to_array# (Array_ data#) = data#
+
+    value_to_bool (Data constr _)
+      | constr == mk_constr "True" = True
+      | constr == mk_constr "False" = False
+
+    value_to_bytearray value =
+      ByteArray
+        (error "value_to_bytearray" :: (Int, Int))
+        (value_to_bytearray# (case value of Data _ [_, value] -> value))
+
+    value_to_bytearray# (ByteArray_ data#) = data#
+
+    value_to_char value =
+      C# (value_to_char# (case value of Data _ [value] -> value))
+
+    value_to_char# (Char c#) = c#
+
+    value_to_foreignobj value =
+      ForeignObj (value_to_foreignobj# (case value of Data _ [value] -> value))
+
+    value_to_foreignobj# (ForeignObj_ obj#) = obj#
+
+    value_to_int value =
+      I# (value_to_int# (case value of Data _ [value] -> value))
+
+    value_to_int# (Int n#) = n#
+
+    value_to_mutablearray# (MutableArray_ data#) = data#
+
+    value_to_mutablebytearray# (MutableByteArray_ data#) = data#
+
+    value_to_mutvar# (MutVar var#) = var#
+
+    value_to_state# (State s#) = s#
+
+    value_to_string (Data _ []) = []
+    value_to_string (Data _ [value1, value2]) =
+      value_to_char value1 : value_to_string value2
+
+    value_to_weak# (Weak_ weak#) = weak#
+
+    value_to_word value =
+      W# (value_to_word# (case value of Data _ [value] -> value))
+
+    value_to_word# (Word word#) = word#
+
+    weak_to_value# weak# = Weak_ weak#
+
+    word_to_value word =
+      Data (mk_constr "W#") [word_to_value# (case word of W# word# -> word#)]
+
+    word_to_value# word# = Word word#
+
