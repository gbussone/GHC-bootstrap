+        (unwrap "stmts2 [ReturnStmt] lookup return_"
+         $ lookup (mk_var "return_")
+         $ unwrap "stmts2 [ReturnStmt] lookup PrelBase"
+         $ lookup (mk_module "PrelBase") module_envs)
+        [unwrap "stmts2 [ReturnStmt] lookup monad_witness"
+         $ lookup (mk_type "[]", mk_var "monad_witness") instances,
