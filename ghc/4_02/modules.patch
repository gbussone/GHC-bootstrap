+\begin{code}
+{-# OPTIONS -monly-3-regs -I../lib/std -Iparser -#include "cbits/timezone.h" -#include "ctypes.h" -#include "hspincl.h" #-}
+
+module Interpreter ( interpret ) where
+
+import BasicTypes	( RecFlag(..) )
+import FastString	( FastString(..), mkFastString, unpackFS )
+import HsBasic		( HsLit(..) )
+import HsBinds		( HsBinds(..), MonoBinds(..), Sig(..) )
+import HsDecls		( ConDecl(..), ConDetails(..), ForeignDecl(..), ForKind(..), HsDecl(..), InstDecl(..), TyClDecl(..) )
+import HsExpr		( ArithSeqInfo(..), HsExpr(..), Stmt(..), StmtCtxt(..) )
+import HsImpExp		( IE(..), ImportDecl(..) )
+import HsMatches	( GRHS(..), GRHSs(..), Match(..) )
+import HsPat		( InPat(..) )
+import HsSyn		( HsModule(..) )
+import HsTypes		( HsType(..), HsTyVar(..) )
+import List		( elemIndex )
+import OccName		( clsName, dataName, mkSrcModule, mkSrcOccFS, OccName, tcName, varName, occNameUserString )
+import PrelArr		( ByteArray(..) )
+import PrelAddr		( Addr(..), Word(..) )
+import PrelBase		( Char(..), Int(..) )
+import PrelException	( Exception(..) )
+import PrelGHC
+import PrelIOBase	( ForeignObj(..), IO(..), IOError(..) )
+import PrelST		( STret(..) )
+import RdrName		( isUnqual, mkRdrUnqual, RdrName, rdrNameModule, rdrNameOcc )
+import UgenUtil		( U_VOID_STAR )
+
+import qualified IOExts
+import qualified PrelErr
+
+data Value
+  = Data OccName [Value]
+  | Function (Value -> Value)
+  | Addr Addr#
+  | Array_ (Array# Value)
+  | ByteArray_ ByteArray#
+  | Char Char#
+  | ForeignObj_ ForeignObj#
+  | Int Int#
+  | MutableArray_ (MutableArray# RealWorld Value)
+  | MutableByteArray_ (MutableByteArray# RealWorld)
+  | MutVar (MutVar# RealWorld Value)
+  | State (State# RealWorld)
+  | Weak_ (Weak# Value)
+  | Word Word#
+
+interpret :: [HsModule RdrName (InPat RdrName)] -> U_VOID_STAR -> IO ()
+interpret modules hspmain_result =
+  trace "interpret" $
+  IO
+    (\ s# ->
+      (# value_to_state#
+           (case
+              unwrap "interpret lookup main"
+              $ lookup (mk_var "main")
+              $ unwrap "interpret lookup Main"
+              $ lookup (mk_module "Main") module_envs
+            of
+              Data _ [f] ->
+                case apply f $ state_to_value# s# of
+                  Data _ [value, _] -> value),
+         () #))
+  where
+    addr_to_value addr =
+      Data (mk_constr "A#") [addr_to_value# (case addr of A# addr# -> addr#)]
+
+    addr_to_value# addr# = Addr addr#
+
+    apply (Data constr values) arg = Data constr (values ++ [arg])
+    apply (Function f) arg = f arg
+
+    applys f [] = f
+    applys f (value : values) = applys (apply f value) values
+
+    array_to_value# data# = Array_ data#
+
+    binds EmptyBinds _ = error "TODO binds EmptyBinds"
+    binds (ThenBinds _ _) _ = error "TODO binds ThenBinds"
+    binds (MonoBind monobinds_ _ Recursive) env =
+      trace "binds MonoBind Recursive" $
+      new_env
+      where
+        new_env = monobinds monobinds_ total_env
+        total_env = new_env ++ env
+    binds (MonoBind _ _ _) _ = error "TODO binds MonoBind"
+
+    bool_to_value b = Data (mk_constr $ if b then "True" else "False") []
+
+    bytearray_to_value# data# = ByteArray_ data#
+
+    char_to_value c =
+      Data (mk_constr "C#") [char_to_value# (case c of C# c# -> c#)]
+
+    char_to_value# c# = Char c#
+
+    decl1 (TyClD _) _ = trace "decl1 TyClD" $ []
+    decl1 (InstD _) _ = trace "decl1 InstD" $ []
+    decl1 (DefD _) _ = error "TODO decl1 DefD"
+    decl1 (ValD binds_) env = trace "decl1 ValD" $ binds binds_ env
+    decl1 (ForD foreigndecl_) _ =
+      trace "decl1 ForD" $
+      [foreigndecl foreigndecl_]
+    decl1 (SigD _) _ = error "TODO decl1 SigD"
+    decl1 (FixD _) _ = trace "decl1 FixD" $ []
+
+    decl2 (TyClD tycldecl_) env = trace "decl2 TyClD" $ tycldecl tycldecl_ env
+    decl2 (InstD instdecl_) env = trace "decl2 InstD" $ instdecl instdecl_ env
+    decl2 (DefD _) _ = error "TODO decl2 DefD"
+    decl2 (ValD _) _ = trace "decl2 ValD" $ ([], [], [], [], [])
+    decl2 (ForD _) _ = trace "decl2 ForD" $ ([], [], [], [], [])
+    decl2 (SigD _) _ = error "TODO decl2 SigD"
+    decl2 (FixD _) _ = trace "decl2 FixD" $ ([], [], [], [], [])
+
+    error msg =
+      IOExts.unsafePerformIO $
+      IOExts.performGC >>= \ () ->
+      IOExts.trace msg $
+      IOExts.performGC >>
+      return (PrelErr.error msg)
+
+    export (IEVar name) _ _ env =
+      trace "export IEVar" $
+      [(var_name,
+        unwrap "export IEVar lookup var_name"
+        $ lookup var_name
+        $ if isUnqual name then
+            env
+          else
+            unwrap "export IEVar lookup module_name"
+            $ lookup module_name module_envs)]
+      where
+        module_name = rdrNameModule name
+        var_name = rdrNameOcc name
+    export (IEThingAbs _) _ _ _ = trace "export IEThingAbs" $ []
+    export (IEThingAll _) _ _ _ = trace "export IEThingAll" $ []
+    export (IEThingWith _ _) _ _ _ = trace "export IEThingWith" $ []
+    export (IEModuleContents name) current_module local_env _ =
+      trace "export IEModuleContents" $
+      if name == current_module then
+        local_env
+      else
+        unwrap "export IEModuleContents lookup name"
+        $ lookup name module_envs
+
+    expr (HsVar name) env =
+      trace ("expr HsVar " ++ occNameUserString var_name) $
+      unwrap ("expr HsVar lookup var_name " ++ occNameUserString var_name)
+      $ lookup var_name
+      $ (if isUnqual name then
+           env
+         else
+           unwrap "expr HsVar lookup module_name"
+           $ lookup module_name module_envs)
+        ++ map (\ (constr, _) -> (constr, Data constr [])) constructors
+        ++ methods
+        ++ map
+             (\ (name, constrs) ->
+               (name,
+                Function
+                  (\ (Data constr values) ->
+                    values
+                    !! (unwrap "expr HsVar lookup constr"
+                        $ lookup constr constrs))))
+             fields
+      where
+        module_name = rdrNameModule name
+        var_name = rdrNameOcc name
+    expr (HsLit hslit_) _ = hslit hslit_
+    expr (HsLitOut _ _) _ = error "TODO expr HsLitOut"
+    expr (HsLam match@(Match _ inpats _ _)) env =
+      trace "expr HsLam" $
+      function (length inpats) (\ values -> matchs [match] values env)
+    expr (HsApp expr1 expr2) env =
+      trace "expr HsApp" $
+      apply (expr expr1 env) $ expr expr2 env
+    expr expr_@(OpApp _ _ _ _) env =
+      trace "expr OpApp" $
+      case normalize expr_ of
+        OpApp expr1 op _ expr2 ->
+          applys (expr op env) $ map (\ expr_ -> expr expr_ env) [expr1, expr2]
+        NegApp _ _ -> error "TODO expr OpApp NegApp"
+      where
+        normalize (OpApp expr1 (HsVar op) _ expr2) =
+          mk_opapp (normalize expr1) op (normalize expr2)
+        normalize (OpApp _ _ _ _) = error "TODO normalize OpApp no variable"
+        normalize expr = expr
+        mk_opapp (OpApp expr1 (HsVar op1) _ expr2) op2 expr3
+          | (occNameUserString $ rdrNameOcc op1) == ">>"
+            && (occNameUserString $ rdrNameOcc op2) == ">>"
+            || (occNameUserString $ rdrNameOcc op1) == ">="
+               && (occNameUserString $ rdrNameOcc op2) == "&&"
+            || (occNameUserString $ rdrNameOcc op1) == "&&"
+               && (occNameUserString $ rdrNameOcc op2) == "||"
+            || (occNameUserString $ rdrNameOcc op1) == "geChar#"
+               && (occNameUserString $ rdrNameOcc op2) == "&&"
+            || (occNameUserString $ rdrNameOcc op1) == "=="
+               && (occNameUserString $ rdrNameOcc op2) == "||"
+            || (occNameUserString $ rdrNameOcc op1) == ">>"
+               && (occNameUserString $ rdrNameOcc op2) == ">>="
+            || (occNameUserString $ rdrNameOcc op1) == "seqMaybe"
+               && (occNameUserString $ rdrNameOcc op2) == "seqMaybe"
+            || (occNameUserString $ rdrNameOcc op1) == "<#"
+               && (occNameUserString $ rdrNameOcc op2) == "&&"
+            || (occNameUserString $ rdrNameOcc op1) == ">"
+               && (occNameUserString $ rdrNameOcc op2) == "||"
+            || (occNameUserString $ rdrNameOcc op1) == "<="
+               && (occNameUserString $ rdrNameOcc op2) == "&&"
+            || (occNameUserString $ rdrNameOcc op1) == "+#"
+               && (occNameUserString $ rdrNameOcc op2) == "+#"
+            || (occNameUserString $ rdrNameOcc op1) == "quotInt#"
+               && (occNameUserString $ rdrNameOcc op2) == "-#"
+            || (occNameUserString $ rdrNameOcc op1) == "+"
+               && (occNameUserString $ rdrNameOcc op2) == "<"
+            || (occNameUserString $ rdrNameOcc op1) == "+"
+               && (occNameUserString $ rdrNameOcc op2) == "+"
+            || (occNameUserString $ rdrNameOcc op1) == ">=#"
+               && (occNameUserString $ rdrNameOcc op2) == "&&"
+            || (occNameUserString $ rdrNameOcc op1) == ">=#"
+               && (occNameUserString $ rdrNameOcc op2) == "||"
+            || (occNameUserString $ rdrNameOcc op1) == "+"
+               && (occNameUserString $ rdrNameOcc op2) == "-"
+            || (occNameUserString $ rdrNameOcc op1) == "remInt#"
+               && (occNameUserString $ rdrNameOcc op2) == "+#" =
+            -- op1 > op2 || op1 == op2 == left
+            OpApp
+              (OpApp expr1 (HsVar op1) undefined expr2)
+              (HsVar op2)
+              undefined
+              expr3
+          | (occNameUserString $ rdrNameOcc op1) == "$"
+            && (occNameUserString $ rdrNameOcc op2) == "thenUgn"
+            || (occNameUserString $ rdrNameOcc op1) == "$"
+               && (occNameUserString $ rdrNameOcc op2) == "$"
+            || (occNameUserString $ rdrNameOcc op1) == "&&"
+               && (occNameUserString $ rdrNameOcc op2) == "<="
+            || (occNameUserString $ rdrNameOcc op1) == "||"
+               && (occNameUserString $ rdrNameOcc op2) == ">="
+            || (occNameUserString $ rdrNameOcc op1) == "||"
+               && (occNameUserString $ rdrNameOcc op2) == "&&"
+            || (occNameUserString $ rdrNameOcc op1) == "||"
+               && (occNameUserString $ rdrNameOcc op2) == "<="
+            || (occNameUserString $ rdrNameOcc op1) == "||"
+               && (occNameUserString $ rdrNameOcc op2) == "||"
+            || (occNameUserString $ rdrNameOcc op1) == "&&"
+               && (occNameUserString $ rdrNameOcc op2) == "leChar#"
+            || (occNameUserString $ rdrNameOcc op1) == "&&"
+               && (occNameUserString $ rdrNameOcc op2) == "&&"
+            || (occNameUserString $ rdrNameOcc op1) == "&&"
+               && (occNameUserString $ rdrNameOcc op2) == "neChar#"
+            || (occNameUserString $ rdrNameOcc op1) == "||"
+               && (occNameUserString $ rdrNameOcc op2) == "=="
+            || (occNameUserString $ rdrNameOcc op1) == "."
+               && (occNameUserString $ rdrNameOcc op2) == "."
+            || (occNameUserString $ rdrNameOcc op1) == "$"
+               && (occNameUserString $ rdrNameOcc op2) == "seqMaybe"
+            || (occNameUserString $ rdrNameOcc op1) == "++"
+               && (occNameUserString $ rdrNameOcc op2) == ":"
+            || (occNameUserString $ rdrNameOcc op1) == "&&"
+               && (occNameUserString $ rdrNameOcc op2) == ">"
+            || (occNameUserString $ rdrNameOcc op1) == "$"
+               && (occNameUserString $ rdrNameOcc op2) == "thenRn"
+            || (occNameUserString $ rdrNameOcc op1) == "++"
+               && (occNameUserString $ rdrNameOcc op2) == "++"
+            || (occNameUserString $ rdrNameOcc op1) == "&&"
+               && (occNameUserString $ rdrNameOcc op2) == ">#"
+            || (occNameUserString $ rdrNameOcc op1) == "&&"
+               && (occNameUserString $ rdrNameOcc op2) == "<#"
+            || (occNameUserString $ rdrNameOcc op1) == ">"
+               && (occNameUserString $ rdrNameOcc op2) == "*"
+            || (occNameUserString $ rdrNameOcc op1) == "<"
+               && (occNameUserString $ rdrNameOcc op2) == "*"
+            || (occNameUserString $ rdrNameOcc op1) == "&&"
+               && (occNameUserString $ rdrNameOcc op2) == "<=#"
+            || (occNameUserString $ rdrNameOcc op1) == "||"
+               && (occNameUserString $ rdrNameOcc op2) == "eqChar#"
+            || (occNameUserString $ rdrNameOcc op1) == ":"
+               && (occNameUserString $ rdrNameOcc op2) == "++"
+            || (occNameUserString $ rdrNameOcc op1) == "thenRn_"
+               && (occNameUserString $ rdrNameOcc op2) == "thenRn_"
+            || (occNameUserString $ rdrNameOcc op1) == "thenRn_"
+               && (occNameUserString $ rdrNameOcc op2) == "thenRn"
+            || (occNameUserString $ rdrNameOcc op1) == ">>="
+               && (occNameUserString $ rdrNameOcc op2) == "." =
+            -- op1 < op2 || op1 == op2 == right
+            OpApp expr1 (HsVar op1) undefined (mk_opapp expr2 op2 expr3)
+          | otherwise =
+            error
+              ("TODO mk_opapp OpApp "
+               ++ (occNameUserString $ rdrNameOcc op1)
+               ++ " OpApp "
+               ++ (occNameUserString $ rdrNameOcc op2))
+        mk_opapp (NegApp _ _) _ _ = error "TODO mk_opapp NegApp"
+        mk_opapp expr1 op expr2 = OpApp expr1 (HsVar op) undefined expr2
+    expr (NegApp _ _) _ = error "TODO expr NegApp"
+    expr (HsPar expr_) env = trace "expr HsPar" $ expr expr_ env
+    expr (SectionL _ _) _ = error "TODO expr SectionL"
+    expr (SectionR op expr2) env =
+      trace "expr SectionR" $
+      Function (\ value1 -> applys (expr op env) [value1, expr expr2 env])
+    expr (HsCase expr_ matchs_ _) env =
+      trace "expr HsCase" $
+      matchs matchs_ [expr expr_ env] env
+    expr (HsIf expr1 expr2 expr3 _) env =
+      trace "expr HsIf" $
+      expr
+        (if value_to_bool $ expr expr1 env then
+           expr2
+         else
+           expr3)
+        env
+    expr (HsLet binds_ expr_) env =
+      trace "expr HsLet" $
+      expr expr_ $ binds binds_ env ++ env
+    expr (HsDo DoStmt stmts _) env =
+      trace "expr HsDo DoStmt" $
+      stmts3 stmts env
+    expr (HsDo ListComp stmts _) env =
+      trace "expr HsDo ListComp" $
+      stmts2 stmts env
+    expr (HsDo CaseAlt _ _) _ = error "TODO expr HsDo CaseAlt"
+    expr (HsDo PatBindRhs _ _) _ = error "TODO expr HsDo PatBindRhs"
+    expr (HsDo (FunRhs _) _ _) _ = error "TODO expr HsDo FunRhs"
+    expr (HsDo LambdaBody _ _) _ = error "TODO expr HsDo LambdaBody"
+    expr (HsDoOut _ _ _ _ _ _ _) _ = error "TODO expr HsDoOut"
+    expr (ExplicitList exprs) env =
+      trace "expr ExplicitList" $
+      go $ map (\ expr_ -> expr expr_ env) exprs
+      where
+        go [] = Data (mk_constr "[]") []
+        go (value : values) = Data (mk_constr ":") [value, go values]
+    expr (ExplicitListOut _ _) _ = error "TODO expr ExplicitListOut"
+    expr (ExplicitTuple exprs _) env =
+      trace "expr ExplicitTuple" $
+      Data
+        (mk_constr $ "(" ++ replicate (length exprs) ',' ++ ")")
+        (map (\ expr_ -> expr expr_ env) exprs)
+    expr (HsCon _ _ _) _ = error "TODO expr HsCon"
+    expr (RecordCon constr recordbinds) env =
+      trace "expr RecordCon" $
+      Data
+        (rdrNameOcc constr)
+        (map
+           (\ i ->
+             unwrap "expr RecordCon lookup i" -- FIXME may be non-exhaustive
+             $ lookup i
+             $ map
+                 (\ (name, expr_, _) ->
+                   (unwrap "expr RecordCon lookup constr"
+                    $ lookup (rdrNameOcc constr)
+                    $ unwrap "expr RecordCon lookup name"
+                    $ lookup (rdrNameOcc name) fields,
+                    expr expr_ env))
+                 recordbinds)
+         [0..length recordbinds - 1])
+    expr (RecordConOut _ _ _) _ = error "TODO expr RecordConOut"
+    expr (RecordUpd expr_ recordbinds) env =
+      trace "expr RecordUpd" $
+      case expr expr_ env of
+        Data constr values ->
+          Data
+            constr
+            (map
+               (\ i ->
+                 case
+                   lookup i
+                   $ map
+                       (\ (name, expr_, _) ->
+                         (unwrap "expr RecordUpd lookup constr"
+                          $ lookup constr
+                          $ unwrap "expr RecordUpd lookup name"
+                          $ lookup (rdrNameOcc name) fields,
+                          expr expr_ env))
+                       recordbinds
+                 of
+                   Just value -> value
+                   Nothing -> values !! i)
+             [0..length values - 1])
+    expr (RecordUpdOut _ _ _ _) _ = error "TODO expr RecordUpdOut"
+    expr (ExprWithTySig expr_ _) env =
+      trace "expr ExprWithTySig" $
+      expr expr_ env
+    expr (ArithSeqIn (From expr_)) env =
+      trace "expr ArithSeqIn From" $
+      apply
+        (unwrap "expr ArithSeqIn From lookup enumFrom"
+         $ lookup (mk_var "enumFrom") methods)
+      $ expr expr_ env
+    expr (ArithSeqIn (FromThen _ _)) _ = error "TODO expr ArithSeqIn FromThen"
+    expr (ArithSeqIn (FromTo expr1 expr2)) env =
+      trace "expr ArithSeqIn FromTo" $
+      applys
+        (unwrap "expr ArithSeqIn FromTo lookup enumFromTo"
+         $ lookup (mk_var "enumFromTo") methods)
+      $ map (\ expr_ -> expr expr_ env) [expr1, expr2]
+    expr (ArithSeqIn (FromThenTo _ _ _)) _ =
+      error "TODO expr ArithSeqIn FromThenTo"
+    expr (ArithSeqOut _ _) _ = error "TODO expr ArithSeqOut"
+    expr (CCall _ _ True True _) _ = error "TODO expr CCall True True"
+    expr (CCall _ _ True False _) _ = error "TODO expr CCall True False"
+    expr (CCall name exprs False True _) env =
+      trace "expr CCall False True" $
+      applys
+        (if name == mkFastString "%r = 1;" then
+           io_to_value (_casm_ ``%r = 1;'') int_to_value
+         else if name == mkFastString " ((char *)%0)[(int)%1]=(char)0; " then
+           Function
+             (\ x1 ->
+               Function
+                 (\ x2 ->
+                   io_to_value
+                     (_casm_
+                        `` ((char *)%0)[(int)%1]=(char)0; ''
+                        (value_to_addr x1)
+                        (value_to_int x2))
+                     (\ () -> Data (mk_constr "()") [])))
+         else
+           error ("TODO expr CCall False True " ++ unpackFS name))
+      $ map (\ expr_ -> expr expr_ env) exprs
+    expr (CCall name exprs False False _) env =
+      trace "expr CCall False False" $
+      applys
+        (if name == mkFastString "allocMemory__" then
+           Function
+             (\ x ->
+               io_to_value
+                 (_ccall_ allocMemory__ (value_to_int x))
+                 addr_to_value)
+         else if name == mkFastString "closeFile" then
+           Function
+             (\ x1 ->
+               Function
+                 (\ x2 ->
+                   io_to_value
+                     (_ccall_
+                        closeFile
+                        (value_to_foreignobj x1)
+                        (value_to_int x2))
+                     int_to_value))
+         else if name == mkFastString "fileSize" then
+           Function
+             (\ x1 ->
+               Function
+                 (\ x2 ->
+                   io_to_value
+                     (_ccall_
+                        fileSize
+                        (value_to_foreignobj x1)
+                        (value_to_bytearray# x2))
+                     int_to_value))
+         else if name == mkFastString "freeFileObject" then
+           Function
+             (\ x ->
+               io_to_value
+                 (_ccall_ freeFileObject (value_to_foreignobj x))
+                 (\ () -> Data (mk_constr "()") []))
+         else if name == mkFastString "gabindfst" then
+           Function
+             (\ x ->
+               io_to_value (_ccall_ gabindfst (value_to_addr x)) addr_to_value)
+         else if name == mkFastString "gabindsnd" then
+           Function
+             (\ x ->
+               io_to_value (_ccall_ gabindsnd (value_to_addr x)) addr_to_value)
+         else if name == mkFastString "garg" then
+           Function
+             (\ x ->
+               io_to_value (_ccall_ garg (value_to_addr x)) addr_to_value)
+         else if name == mkFastString "gase" then
+           Function
+             (\ x ->
+               io_to_value (_ccall_ gase (value_to_addr x)) addr_to_value)
+         else if name == mkFastString "gasid" then
+           Function
+             (\ x ->
+               io_to_value (_ccall_ gasid (value_to_addr x)) addr_to_value)
+         else if name == mkFastString "gcasebody" then
+           Function
+             (\ x ->
+               io_to_value (_ccall_ gcasebody (value_to_addr x)) addr_to_value)
+         else if name == mkFastString "gcaseexpr" then
+           Function
+             (\ x ->
+               io_to_value (_ccall_ gcaseexpr (value_to_addr x)) addr_to_value)
+         else if name == mkFastString "gcaseline" then
+           Function
+             (\ x ->
+               io_to_value (_ccall_ gcaseline (value_to_addr x)) int_to_value)
+         else if name == mkFastString "gcbindc" then
+           Function
+             (\ x ->
+               io_to_value (_ccall_ gcbindc (value_to_addr x)) addr_to_value)
+         else if name == mkFastString "gcbindid" then
+           Function
+             (\ x ->
+               io_to_value (_ccall_ gcbindid (value_to_addr x)) addr_to_value)
+         else if name == mkFastString "gcbindw" then
+           Function
+             (\ x ->
